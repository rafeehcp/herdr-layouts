          "min": 260,
          "max": 900,
          "background": "chrome",
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "crew",
              "children": [
                {
                  "id": "crew",
                  "type": "column",
                  "children": [
                    {
                      "id": "spaces",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "min": 90,
                      "content": {
                        "mod": "spaces"
                      }
                    },
                    {
                      "id": "agents",
                      "type": "block",
                      "size": {
                        "weight": 1
                      },
                      "min": 90,
                      "content": {
                        "mod": "agents"
                      }
                    }
                  ]
                },
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "gta5",
